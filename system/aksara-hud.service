[Unit]
Description=Aksara HUD (ESP32 external display)
# Hidup-mati mengikuti kabel: start saat dicolok, stop saat dicabut
BindsTo=dev-aksarahud.device
After=dev-aksarahud.device pipewire.service

[Service]
ExecStart=%h/.local/bin/aksara-hud
Restart=on-failure
RestartSec=2
Nice=5

[Install]
WantedBy=dev-aksarahud.device
